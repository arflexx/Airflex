{
  "name": "airflex-monorepo",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "load:test": "bash tests/load/run-all.sh",
    "load:compare": "node tests/load/compare-baseline.mjs",
    "clean": "turbo run clean",
    "type-coverage": "type-coverage --detail --strict --minimum-coverage 95"
  },
  "devDependencies": {
    "turbo": "^2.0.0",
    "type-coverage": "^2.29.0"
  },
  "pnpm": {
    "overrides": {
      "webpack": "5.101.2"
    }
  },
  "packageManager": "pnpm@10.28.0"
}
